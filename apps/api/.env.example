DATABASE_URL=postgresql://rosevarzan:rosevarzan@localhost:55433/rosevarzan?schema=public
PORT=4010
WEB_ORIGIN=http://localhost:3020
# Publicly reachable base URL of this API — used to build the Zarinpal
# callback URL. Must be a real public URL in production (Zarinpal calls it
# server-to-server on redirect), localhost is fine for local dev only.
API_PUBLIC_URL=http://localhost:4010
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
ADMIN_EMAIL=admin@rosevarzan.com
ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password

# Zarinpal (Iran online payment gateway). The sandbox values below work out of
# the box against https://sandbox.zarinpal.com for local testing with no real
# merchant account. Before going live, replace ZARINPAL_MERCHANT_ID with the
# cooperative's real merchant ID from https://next.zarinpal.com and switch
# ZARINPAL_BASE_URL / ZARINPAL_GATEWAY_URL to the production endpoints below.
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_BASE_URL=https://sandbox.zarinpal.com/pg/v4/payment
ZARINPAL_GATEWAY_URL=https://sandbox.zarinpal.com/pg/StartPay
# Production values (uncomment once a real merchant ID is issued):
# ZARINPAL_BASE_URL=https://payment.zarinpal.com/pg/v4/payment
# ZARINPAL_GATEWAY_URL=https://payment.zarinpal.com/pg/StartPay
